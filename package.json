{
  "name": "pakadbandi",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build-performance.mjs && playwright test",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.ts *.json eslint.config.js index.html README.md"
  },
  "keywords": [],
